{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "TeamPilot.API",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "src/TeamPilot.API", "--launch-profile", "https"],
      "port": 7085,
      "url": "https://localhost:7085"
    },
    {
      "name": "TeamPilot.UI",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start", "--prefix", "src/TeamPilot.UI"],
      "port": 4200
    }
  ]
}
