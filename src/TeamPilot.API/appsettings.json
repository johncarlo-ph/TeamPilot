{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=TeamPilotDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Llm": {
    "Provider": "Claude",
    "ApiKey": "",
    "Model": "claude-sonnet-4-5",
    "BaseUrl": "https://api.anthropic.com",
    "TimeoutSeconds": 60
  },
  "Git": {
    "DefaultAuthorEmail": "teampilot@local"
  },
  "Jwt": {
    "SigningKey": "",
    "Issuer": "TeamPilot",
    "Audience": "TeamPilot.Client",
    "AccessTokenLifetimeMinutes": 15
  },
  "Auth": {
    "RefreshTokenLifetimeDays": 14,
    "SeedAdminEmails": [],
    "Providers": {
      "Google": {
        "MetadataAddress": "https://accounts.google.com/.well-known/openid-configuration",
        "Audience": ""
      },
      "Microsoft": {
        "MetadataAddress": "https://login.microsoftonline.com/common/v2.0/.well-known/openid-configuration",
        "Audience": ""
      }
    }
  }
}
